<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to StudyMate!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:layout_marginBottom="6dp"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your studies and tasks efficiently."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"
            android:textAlignment="center" />

        <!-- Tasks Page -->
        <Button
            android:id="@+id/btnManageTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tasks"
            android:textColor="@android:color/white"
            android:backgroundTint="#6200EE"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Pomodoro Page -->
        <Button
            android:id="@+id/btnPomodoro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pomodoro Timer"
            android:textColor="@android:color/white"
            android:backgroundTint="#03DAC5"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Exam Countdown Page -->
        <Button
            android:id="@+id/btnExamCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exam Countdown"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF9800"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Notes Page Button -->
        <Button
            android:id="@+id/btnNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Notes"
            android:textColor="@android:color/white"
            android:backgroundTint="#009688"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Profile Page (Personal Info & Picture) -->
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textColor="@android:color/white"
            android:backgroundTint="#3F51B5"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Settings & Sensors Page (Shake, Browser, Email) -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Settings &amp; Sensors"
            android:textColor="@android:color/white"
            android:backgroundTint="#673AB7"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="@android:color/white"
            android:backgroundTint="#D32F2F"
            android:padding="12dp" />

        <include
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>

    </LinearLayout>
</ScrollView>