<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage Tasks"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#6200EE"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Search & Filter Controls -->
    <EditText
        android:id="@+id/etSearchTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search tasks..."
        android:padding="10dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSortTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sort"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnFilterPriority"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filter Priority"
            android:backgroundTint="#009688"
            android:textColor="@android:color/white"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task Counters (Total, Completed, Remaining) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EDE7F6"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvTotalTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: 0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#311B92"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvCompletedTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Done: 0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvRemainingTasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remain: 0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:gravity="center" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvNoTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tasks found!"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Task"
        android:layout_marginBottom="8dp" />

    <!-- Footer Bottom Navigation -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>